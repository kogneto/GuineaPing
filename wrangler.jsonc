{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "guineaping",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Sentry's SDK needs Node's AsyncLocalStorage.
  "compatibility_flags": ["nodejs_compat"],
  // Lets Sentry say which deployed version an error came from.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // Only the workers.dev address, which Cloudflare Access protects; no per-version preview URLs.
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "guineaping",
      "database_id": "5a5fb98a-2957-436e-a394-8ae72bc41d73",
      "migrations_dir": "migrations"
    }
  ],
  // The hourly Check, at minute 17 to stay clear of the top-of-hour rush. At minute 47, the Clinic
  // read: one Clinic source per run, each source at most once a day (src/worker/openings/read.ts).
  "triggers": { "crons": ["17 * * * *", "47 * * * *"] },
  "vars": {
    // Cloudflare Access lets Members in: the "GuineaPing" Access application on this Worker's
    // workers.dev host. If that application is ever recreated it gets a new AUD tag; put the new
    // one here and deploy, or every sign-in is refused.
    "ACCESS_TEAM_DOMAIN": "white-brook-3170.cloudflareaccess.com",
    "ACCESS_AUD": "aeba8dff7feda6d22106f2103fd4ac1a843c3837bdc08d5bfdde24bc3a87b2d5",
    // Which Access policy lists the Members' email addresses, so the app can invite and remove
    // them. This only works once the CF_ACCESS_TOKEN secret is set (see README).
    "CF_ACCOUNT_ID": "b2dc3e8a66849473a9c8174a2072db36",
    "ACCESS_APP_ID": "bd296c89-8fa8-44cc-9123-dbd2b1129f96",
    "ACCESS_POLICY_ID": "f10b86d9-7394-4589-82cb-2bbefb6a04c4",
    // Where errors and failed Checks are reported (Sentry project "guineaping"). A DSN only lets
    // its holder send events, so it is fine in this file. See src/worker/report.ts for what is sent.
    "SENTRY_DSN": "https://a19e045986578197544348372ec18676@o4512160331530240.ingest.us.sentry.io/4512477165453312",
    // Only ever "true" in .dev.vars, and even then honoured only on localhost.
    "DEV_AUTH": "false"
  },
  "observability": { "enabled": true }
}
